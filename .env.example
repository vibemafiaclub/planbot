# Slack App (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# 봇이 탐색할 레포들의 부모 디렉터리 (repo들이 이 아래 clone 되어 있어야 함)
REPO_ROOT=C:\planbot\repos

# claude CLI 경로 (PATH에 없으면 절대경로 지정, 예: C:\Users\...\claude.cmd)
CLAUDE_BIN=claude

# MCP 콜백 서버 로컬 포트
CALLBACK_PORT=8788

# claude 세션 타임아웃 (ms)
CLAUDE_TIMEOUT_MS=1800000

# 처리중 표시 리액션 이모지 이름 (워크스페이스에 등록된 커스텀 이모지, 기본값 loading)
# LOADING_REACTION=loading

# jira-cli 경로 (PATH에 없으면 절대경로 지정) — Jira 댓글 등록(승인 후)에 사용
# JIRA_BIN=jira

# claude 세션 모델 (기본 sonnet)
# CLAUDE_MODEL=sonnet

# dev 커맨드(봇 자체 지침·코드 수정)를 쓸 수 있는 관리자 Slack user ID (콤마 구분).
# 비워두면 dev 커맨드는 전면 비활성화된다.
# DEV_ALLOWED_USER_IDS=U0XXXXXXX,U0YYYYYYY

# 채널 스레드에서 자동 반응(재멘션 불필요)이 유지되는 최대 유휴 시간 (ms, 기본 24시간)
# AUTO_REPLY_TTL_MS=86400000

# Graphviz dot 실행 파일 경로 (PATH에 없으면 절대경로 지정) — 작동 흐름 다이어그램 렌더링에 사용
# GRAPHVIZ_BIN=dot

# 다이어그램 한글 폰트 (기본 "Malgun Gothic" — Windows 기본 탑재. macOS면 "AppleGothic" 등으로 변경)
# DIAGRAM_FONT=Malgun Gothic
