# Slack App (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# 봇이 탐색할 레포들의 부모 디렉터리 (repo들이 이 아래 clone 되어 있어야 함)
REPO_ROOT=C:\planbot\repos

# claude CLI 경로 (PATH에 없으면 절대경로 지정, 예: C:\Users\...\claude.cmd)
CLAUDE_BIN=claude

# MCP 콜백 서버 로컬 포트
CALLBACK_PORT=8788

# claude 세션 타임아웃 (ms)
CLAUDE_TIMEOUT_MS=1800000

# 처리중 표시 리액션 이모지 이름 (워크스페이스에 등록된 커스텀 이모지, 기본값 loading)
# LOADING_REACTION=loading

# jira-cli 경로 (PATH에 없으면 절대경로 지정) — Jira 댓글 등록(승인 후)에 사용
# JIRA_BIN=jira
